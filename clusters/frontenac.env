# Frontenac (CAC, Queen's) — COORDINATOR
CLUSTER_NAME="frontenac"
CLUSTER_ROLE="coordinator"
# Paths
PROJECT_ROOT="/global/project/hpcg6049/lecanemab-am"
SCRATCH_ROOT="/global/scratch/hpc6049/lecanemab-am"
# SLURM (NO --partition on Frontenac)
SLURM_ACCOUNT="def-hpcg6049_gpu"
GPU_TYPE="a100"
GPU_GRES="gpu:a100:1"
MAX_WALLTIME="08:00:00"          # tune per job
MAIN_MEM="48G"
# Conda envs (canonical names on this cluster) — mapped 2026-06-03, see docs/env/env_mapping.md
# Role vars (CLAUDE.md §5). "BUILD-NEEDED" = env not yet provisioned on Frontenac.
CONDA_ENV_MAIN="lecam"                 # ✅ orchestration/analysis (ANARCI 2026.2.13.2)
CONDA_ENV_AB="lecam-ab"                # ✅ BUILT 2026-06-03: ImmuneBuilder/IgFold/AntiBERTy/AbLang2 (torch2.5.1 cpu); BioPhi/Sapiens deferred
CONDA_ENV_FOLD="lecam-fold"            # ✅ BUILT+A100-VERIFIED 2026-06-03: Boltz-2 2.2.1 [cuda] (torch2.12 cu130, cuequivariance); weights → $BOLTZ_CACHE. AF3=container (pending)
CONDA_ENV_CHAI="lecam-chai"            # ✅ BUILT 2026-06-03: Chai-1 0.6.1 (own env; dep conflict w/ Boltz); weights → $CHAI_CACHE
CONDA_ENV_DESIGN="lecam-design"        # ◐ umbrella; use the per-tool envs below (RFantibody/LigandMPNN/SolubleMPNN still missing)
CONDA_ENV_ROSETTA="lecam-rosetta"      # ⛔ BUILD-NEEDED: flex_ddG/FoldX/AbLIFT (PyRosetta avail now → CONDA_ENV_PYROSETTA)
CONDA_ENV_MD="lecam-md"                # ✅ BUILT+A100-VERIFIED 2026-06-03: OpenMM 8.2 (CUDA) + pdbfixer + mdtraj; run w/ LD_LIBRARY_PATH=$CONDA_PREFIX/lib
CONDA_ENV_DEV="lecam-dev"              # ⛔ BUILD-NEEDED: Aggrescan3D/NetSolP/SoluProt/TAP/DeepViscosity
# Existing reusable envs mapped to roles (verified present on Frontenac 2026-06-03):
CONDA_ENV_COLABFOLD="colabfold"        # AF2/ColabFold 1.6.1, jax0.6/CUDA12, OpenMM 8.5.1; weights cached ~/.cache/colabfold (5.3G)
CONDA_ENV_MPNN="mpnn"                  # ProteinMPNN runtime (py3.9, torch2.7.1); repo: /global/project/hpcg6049/protein/ProteinMPNN
CONDA_ENV_RFDIFF="rfd_clean"           # RFdiffusion 1.1.0 (torch2.5.1/cu11.8, se3-transformer, dgl); alt env: rfdiffusion (torch2.0.1)
CONDA_ENV_SE3="SE3nv"                  # RFdiffusion SE3-transformer support env (py3.9)
CONDA_ENV_BINDCRAFT="BindCraft"        # BindCraft + ColabDesign 1.1.3 + PyRosetta 2026.3 + OpenMM; repo: /global/project/hpcg6049/protein/alzheimer/bindcraft
CONDA_ENV_PYROSETTA="BindCraft"        # PyRosetta 2026.3 host (interim until dedicated lecam-rosetta)
# Model-weight caches (on scratch — multi-GB, NOT in $HOME or git). Set at runtime.
BOLTZ_CACHE="${SCRATCH_ROOT}/cache/boltz"   # boltz predict --cache "$BOLTZ_CACHE"
CHAI_CACHE="${SCRATCH_ROOT}/cache/chai"     # export CHAI_DOWNLOADS_DIR="$CHAI_CACHE"
# Containers
CONTAINER_DIR="${PROJECT_ROOT}/container"
# Globus
GLOBUS_ENDPOINT="CONFIRM"        # Frontenac personal endpoint UUID
GLOBUS_BASE_PATH="${PROJECT_ROOT}"
